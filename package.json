{
  "name": "deepseek-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "A pnpm workspace that hosts several DeepSeek Harness (dsh) plugins, one bundle package per plugin.",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxn404/deepseek-plugins.git"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:scripts": "node --test scripts/workspace.test.ts",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm test:scripts",
    "market": "node scripts/market.ts",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
