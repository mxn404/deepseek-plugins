{
  "name": "dsh-new-session",
  "version": "0.0.0",
  "description": "A `/new` slash command in the Web GUI composer: start a fresh Session in the current Workspace without leaving the keyboard.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "session",
    "command"
  ],
  "license": "MIT",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remote-access": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "author": "mxn404",
  "homepage": "https://github.com/mxn404/deepseek-plugins/tree/main/packages/dsh-new-session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxn404/deepseek-plugins.git",
    "directory": "packages/dsh-new-session"
  }
}
