# Build output. Nothing here is committed: a git-installed plugin rebuilds from
# source through its `prepare` script, and npm installs the built tarball.
lib/
*.tsbuildinfo

# Dependencies and local package stores.
node_modules/
.pnpm-store/

# Local scratch caches used while scaffolding in this checkout.
.npm-cache/
.pnpm-cache/

# Generated market index. `pnpm market` recreates it; the deploy workflow uploads
# it from the build job. Remove these two lines to publish the index from git.
site/index.json
site/icons/

# Local scratch directories used when verifying installs and clones.
.market-test*/
.verify-*/
.test-home/

# Tooling output.
coverage/
*.log
.DS_Store
